# Asterisk ARI
ARI_URL=http://127.0.0.1:8088
ARI_USERNAME=medbot
ARI_PASSWORD=Medbot$ARI2024!
ARI_APP_NAME=medbot

# RTP for ExternalMedia
EXTERNAL_MEDIA_HOST=127.0.0.1
RTP_PORT_START=30000
RTP_PORT_END=30100

# LLM (OpenRouter)
LLM_API_KEY=sk-or-...
LLM_MODEL=google/gemini-2.0-flash-001
LLM_BASE_URL=https://openrouter.ai/api/v1

# ElevenLabs TTS
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
# Модели: eleven_multilingual_v2 | eleven_flash_v2_5 | eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# STT — Groq Whisper (free, sign up at console.groq.com)
STT_API_KEY=gsk_...
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3

# LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=medtech-agent
LANGSMITH_TRACING=true

# Medesk
MEDESK_API_KEY=...
MEDESK_BASE_URL=https://api.medesk.md/api/v2

# Тестовый Telegram-бот (ai_agent.tg_test_bot) и HTTP API агента (uvicorn ai_agent.app:app)
TELEGRAM_BOT_TOKEN=
# Локально: http://127.0.0.1:8000 | в Docker Compose tg-test-bot подставляет http://ai-agent-api:8000
AI_AGENT_API_URL=http://127.0.0.1:8000
# Для ответов агента в /chat нужен LLM_API_KEY (см. выше)
